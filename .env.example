# Academic Nexus - environment variables
# Copy this file to .env and fill in your own values.
# Vite only exposes variables prefixed with VITE_ to the browser.
#
# Everything here is a PUBLIC, browser-safe key. Never put a service role key,
# a Stripe secret key, or any other server-side secret in this file - anything
# with a VITE_ prefix is bundled into the JavaScript your users download.

# --- Supabase (required) -----------------------------------------------------
# Project settings -> API. Use the anon/publishable key, never the service role.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Google AI Studio / Gemini (AI chat assistant) ---------------------------
# https://aistudio.google.com/app/apikey
VITE_GOOGLE_AI_API_KEY=your-google-ai-key

# --- ElevenLabs (voice: speech to text + text to speech) ---------------------
# https://elevenlabs.io -> Profile -> API key
VITE_ELEVENLABS_API_KEY=your-elevenlabs-key

# --- Stripe (payments) -------------------------------------------------------
# Publishable key only. Starts with pk_test_ or pk_live_.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
# Optional. URL of an endpoint that creates a PaymentIntent and returns a
# clientSecret. Without it the app runs payments in clearly-labelled demo mode,
# since a real charge cannot be created from the browser alone.
VITE_STRIPE_PAYMENT_INTENT_URL=

# --- Google Calendar (adds confirmed sessions to the student's calendar) -----
# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web application).
# Add your app origin to Authorized JavaScript origins and
# <origin>/oauth/google to Authorized redirect URIs.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
